# 이 파일은 템플릿입니다. 실제 값을 넣은 .env를 별도로 만들어 사용하세요.
# .env는 gitignore 되어있습니다.

# 데디 서버가 /servers/* 및 /sessions/:id/finish 엔드포인트 호출 시
# x-server-api-key 헤더로 전달할 키
SERVER_API_KEY=change-me

# JWT 서명 시크릿 (32자 이상 랜덤 권장)
JWT_SECRET=change-me-long-random-string

# Redis 패스워드 (docker-compose 가 redis 컨테이너에 자동 주입)
REDIS_PASSWORD=change-me-redis-password

# Redis URL
# docker-compose 환경: redis://:${REDIS_PASSWORD}@redis:6379  (서비스명 = redis)
# 로컬 직접 실행: redis://:yourpassword@localhost:6379
REDIS_URL=redis://:change-me-redis-password@redis:6379

# NestJS HTTP 포트
PORT=3000
